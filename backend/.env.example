# App Foundry injects these values at runtime. Do not commit real credentials.
PORT=8080

# Comma-separated origins. Add the unpacked extension origin after loading it.
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Optional until the App Foundry catalog provides the exact values.
POMERIUM_ISSUER=
POMERIUM_AUDIENCE=

# App Foundry PostgreSQL values will be injected when the database is enabled.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
