# Copy to .env and keep it out of git. The unpacked Chrome extension
# reads values from extension/collab/config.js (not from this file).
# After creating a Supabase project, paste the same values there.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
ALLOWED_EMAIL_DOMAIN=yourcompany.com
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_FROM_EMAIL=handoff@yourcompany.com
