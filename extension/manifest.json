{
  "name": "VibeCheck",
  "version": "0.1.0",
  "description": "Drop feedback pins on vibe-coded prototypes — internal design handoff tool",
  "manifest_version": 3,
  "icons": { "128": "icons/vibecheck.png" },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "visbug.js",
    "type": "module"
  },
  "action": {
    "default_title": "VibeCheck — Alt+Shift+D to toggle tools",
    "default_icon": {
      "128": "icons/vibecheck.png"
    }
  },
  "web_accessible_resources": [{
    "resources": [
      "tuts/*.gif",
      "toolbar/*",
      "popup/*",
      "supabase.config.json"
    ],
    "matches": ["<all_urls>"]
  }],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "windows": "Alt+Shift+D",
        "mac": "Alt+Shift+D",
        "chromeos": "Alt+Shift+D",
        "linux": "Alt+Shift+D"
      },
      "description": "Toggle VibeCheck on this page"
    }
  }
}
