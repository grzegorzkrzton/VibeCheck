{
  "name": "VibeCheck",
  "version": "0.1.1",
  "description": "Drop feedback pins on vibe-coded prototypes — internal design handoff tool",
  "manifest_version": 3,
  "icons": {
    "128": "icons/vibecheck.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://vibecheck-backend.internal.zenai-apps.com/*"
  ],
  "background": {
    "service_worker": "vibecheck.js",
    "type": "module"
  },
  "action": {
    "default_title": "VibeCheck — Alt+Shift+D to toggle tools",
    "default_icon": {
      "128": "icons/vibecheck.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tuts/*.gif",
        "toolbar/*",
        "popup/*",
        "fonts/figtree/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "windows": "Alt+Shift+D",
        "mac": "Alt+Shift+D",
        "chromeos": "Alt+Shift+D",
        "linux": "Alt+Shift+D"
      },
      "description": "Toggle VibeCheck on this page"
    }
  }
}
